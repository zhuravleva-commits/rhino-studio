# Приём заявок в Telegram. Скопируйте файл в .env.local и подставьте значения —
# .env* уже в .gitignore, в репозиторий они не попадут.
#
# TELEGRAM_BOT_TOKEN — выдаёт @BotFather при создании бота.
# TELEGRAM_CHAT_ID   — куда слать заявки: ваш личный id (узнать у @userinfobot)
#                      или id группы, в которую добавлен бот (тогда со знаком минус).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
