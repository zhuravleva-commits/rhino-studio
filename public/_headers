# Заголовки для файлов, которые хостинг отдаёт напрямую, минуя сервер
# (картинки, ролики, шрифты, скрипты сборки). Для страниц — middleware.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Файлы сборки с хешем в имени не меняются — кешируем навсегда.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
